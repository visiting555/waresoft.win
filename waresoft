    FOVCircle = Drawing.new("Circle")
    FOVCircle.Visible = true
    FOVCircle.Radius = States.AimbotFOV
    FOVCircle.Thickness = 2
    FOVCircle.Color = Color3.fromRGB(0, 255, 100)
    FOVCircle.Transparency = 0.5
