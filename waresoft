local function SwitchTab(tab)
    CurrentTab = tab
    for _, btn in ipairs(TabButtons) do
        btn.BackgroundColor3 = (btn.Text == tab) and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(20, 22, 40)
        btn.TextColor3 = (btn.Text == tab) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 170)
    end
    for _, v in ipairs(Scroll:GetChildren()) do
        if v:IsA("Frame") or v:IsA("TextLabel") or v:IsA("TextButton") then
            v.Visible = false
        end
    end
    for _, v in ipairs(Scroll:GetChildren()) do
        if v:IsA("Frame") and v.Name == tab then
            v.Visible = true
            for _, child in ipairs(v:GetChildren()) do
                child.Visible = true
            end
        end
        if v:IsA("TextLabel") and v.Name == "Guide" and tab == "GUIDE" then
            v.Visible = true
        end
    end
end

